  "settings": {
    "match": "case-insensitive whole word",
    "repeatScope": "same speaker and exact word",
    "repeatWindowSeconds": 8,
    "timeSource": "word start in recording seconds",
    "lateWeightStartsAtSeconds": 900,
    "lateWeightReachesFloorAtSeconds": 1200,
    "speechShare": "speaker timed speech divided by total timed speech of the five selected speakers",
    "referenceSpeechShare": 0.2,
    "minimumSpeechRatio": 0.5,
    "maximumSpeechRatio": 2.0
  },
  "formulas": {
    "lateProgress": "clamp((timeSeconds - lateWeightStartsAtSeconds) / (lateWeightReachesFloorAtSeconds - lateWeightStartsAtSeconds), 0, 1)",
    "timeMultiplier": "1 + lateProgress * (lateWeightMultiplier - 1)",
    "speechRatio": "clamp(referenceSpeechShare / speakerSpeechShare, minimumSpeechRatio, maximumSpeechRatio)",
    "speechMultiplier": "1 + speechScalingAdjustment * (speechRatio - 1)",
    "pointsPerRole": "weight * timeMultiplier * speechMultiplier"
  },
